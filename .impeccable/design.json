  "narrative": {
    "northStar": "The Two-Room Studio",
    "overview": "Two faces, one system. The library room is a dim space for fast auditioning — rows of waveforms, keyboard-first, nothing competing with the sound. The studio room is a workbench for shaping a found sound fast — trim, EQ, seamless loop, variation takes — dense controls that reward precision. dyvoided.2 carries both: cool graphite neutrals, four seed-driven accents assigned by category, presence 0.45 tactility.",
    "keyCharacteristics": [
      "Neutral graphite canvas; accents are semantic categories, not ornament",
      "primary=user intent, accent-2=live audio signal, accent-1=processing, accent-3=machine-proposed",
      "Custom canvas instruments share the DOM token palette",
      "Keyboard-first, dark-only, compact density available"
    ],
    "rules": [
      { "name": "The Category Rule", "body": "An accent hue means exactly one category app-wide. Teal never decorates; magenta never marks a user action. New color joins a category or stays neutral.", "section": "colors" },
      { "name": "The Rarity Rule", "body": "The graphite canvas owns the room; accents appear where they inform. ~10% colored pixels on a screen preserves hierarchy.", "section": "colors" }
    ],
    "dos": [
      "Do spend accents by category: teal for live audio, amber for processing, magenta for machine proposals, indigo for user intent.",
      "Do render controls with the kit's compound markup (ds-slider-track/fill/knob, ds-select, ds-check).",
      "Do keep numbers in mono with tabular figures and labels in uppercase mono micro-style.",
      "Do give every interactive element a --focus-ring and an accessible name."
    ],
    "donts": [
      "Don't color waveform channels differently — channels differentiate by position, not hue.",
      "Don't hardcode hues or shadows — reference tokens; --presence owns tactility.",
      "Don't use --signature for anything functional; it is the panel top-edge only.",
      "Don't use emoji or unicode glyphs in place of drawn icons."
    ]
  }
